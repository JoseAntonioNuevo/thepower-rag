# GUÍA DE LECTURA · lab/.env.example
# Copia a lab/.env y guarda allí tus propias claves; lab/.env está ignorado por Git.
# Destino local y credenciales ficticias del aula; el CLI rechaza otro host, puerto o base.
DATABASE_URL=postgresql://aether:aether_lab_2026@127.0.0.1:54329/aether_rag
# Ruta de inferencia del embedding: openrouter o gemini directo.
LAB_EMBEDDING_PROVIDER=openrouter
# Identificador servido por esa ruta; no mezclar su índice con el de otro modelo o proveedor.
EMBEDDING_MODEL_ID=google/gemini-embedding-2
# Proveedor de la respuesta escrita, independiente del que produce embeddings.
LAB_GEN_PROVIDER=anthropic
# Modelo generativo registrado en el ensayo y en los recibos del laboratorio.
GEN_MODEL_ID=claude-sonnet-5-5
# Tarifas de reserva por millón de tokens; comprueba las de tu proveedor antes de cambiar modelo.
LAB_EMBED_USD_PER_MILLION=0.2
# Entrada del generador: instrucciones, pregunta y fragmentos del contexto.
LAB_GEN_INPUT_USD_PER_MILLION=2
# Salida del generador: se reserva su cota máxima antes de enviar la llamada.
LAB_GEN_OUTPUT_USD_PER_MILLION=10
# Añade tus claves en el archivo privado, o déjalas en el entorno de la terminal.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
