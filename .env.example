# Nombres y marcadores. No pongas secretos reales en este archivo.
# La clave real va en .env, que Git ignora. Copia este archivo y sustituye el marcador.
# bun run dev y bun run dev:real leen LLM_PROVIDER, LLM_REASONING_EFFORT y las claves
# de proveedor desde ese .env cuando apps/web/.dev.vars no las trae configuradas.
# El Worker no mezcla el resto de process.env. No uses variables VITE_*.
# APP_MODE=demo no necesita credenciales.
# APP_MODE=real para sin RAG necesita la clave del proveedor y MODEL_ID.
#
# Proveedor de todos los modelos generativos (chat, RAG, CRAG, investigación y visión):
#   anthropic   Claude por la API de Anthropic. Vacío equivale a anthropic.
#   openai      GPT por la API de OpenAI (OPENAI_API_KEY).
#   openrouter  Cualquier modelo de openrouter.ai/models (OPENROUTER_API_KEY);
#               IDs como z-ai/glm-5.3, moonshotai/kimi-k3 u openai/gpt-6-luna.
#   gemini      Gemini con clave de Google AI Studio (GEMINI_API_KEY).
#   compatible  Cualquier API compatible con Chat Completions: COMPAT_BASE_URL
#               (https, o http solo hacia localhost) y COMPAT_API_KEY si la pide.
# MODEL_ID, EVALUATOR_MODEL_ID y RESEARCH_MODEL_ID van en el formato de ese proveedor.
# LLM_REASONING_EFFORT es opcional: none, minimal, low, medium, high, xhigh, max u omitir.
# Vacío deja que cada ruta pida poco razonamiento (ver README).
# RAG real necesita además el modelo de embeddings, su dimensión observada,
# la versión del corpus, el perfil de índice, la métrica cosine, el umbral
# y los bindings AI, VECTORIZE, DB y CORPUS.
# La generación lista no implica que el RAG esté listo.
# EVALUATOR_MODEL_ID queda para CRAG y no bloquea las otras etapas.
# RESEARCH_MODEL_ID es el mismo Claude Haiku 5.5. La investigación real sigue bloqueada.
# Las tarifas *_USD_PER_MILLION son las del modelo elegido: cámbialas si cambias de modelo.

APP_MODE=demo
LLM_PROVIDER=anthropic
LLM_REASONING_EFFORT=
ANTHROPIC_API_KEY=replace-with-a-local-secret
ANTHROPIC_WORKSPACE_ID=replace-with-the-workspace-id
OPENAI_API_KEY=replace-with-a-local-secret
OPENROUTER_API_KEY=replace-with-a-local-secret
GEMINI_API_KEY=replace-with-a-local-secret
COMPAT_BASE_URL=replace-with-https-base-url
COMPAT_API_KEY=replace-with-a-local-secret
MODEL_ID=claude-haiku-5-5
EMBEDDING_MODEL=replace-with-workers-ai-model
EMBEDDING_DIMENSIONS=replace-with-observed-dimension
CORPUS_VERSION=replace-with-corpus-version
INDEX_PROFILE=replace-with-index-profile
VECTOR_METRIC=cosine
MIN_RETRIEVAL_SCORE=replace-with-calibrated-score
EVALUATOR_MODEL_ID=claude-haiku-5-5
RESEARCH_MODEL_ID=claude-haiku-5-5
MODEL_INPUT_USD_PER_MILLION=0.1
MODEL_OUTPUT_USD_PER_MILLION=0.5
EVALUATOR_INPUT_USD_PER_MILLION=0.1
EVALUATOR_OUTPUT_USD_PER_MILLION=0.5
